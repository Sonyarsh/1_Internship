# Скопируйте в .env и подставьте свой пароль:
#   copy .env.example .env
#
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://postgres:password@localhost:5432/concrete_strength_db

# --- Отправка результатов протоколов ---
# true = не слать наружу, писать в notifications.log (удобно для учёбы)
NOTIFY_DRY_RUN=true

# Email (SMTP). Пример для Gmail: smtp.gmail.com + пароль приложения
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Telegram: создайте бота у @BotFather, возьмите token.
# Chat id: напишите боту /start, затем узнайте id (например через @userinfobot)
# или оставьте пустым и вводите chat_id в форме отправки.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
